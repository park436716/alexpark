  "evidence_matrix": {
    "fraud": [
      "AVS/CVV match logs",
      "3-D Secure (3DS) authentication result (ECI/CAVV)",
      "IP address, device fingerprint, geolocation",
      "Shipping address vs billing address match",
      "Delivery signature or tracking with signature",
      "Prior transaction history with same cardholder"
    ],
    "authorization": [
      "Authorization approval code and timestamp",
      "Authorization amount vs settled amount reconciliation",
      "Force-post reason, if any",
      "MID/TID and settlement batch reference"
    ],
    "processing_error": [
      "Original transaction receipt / TID",
      "Settlement batch report showing single posting",
      "Refund confirmation or credit transaction ARN",
      "Currency conversion table used at capture"
    ],
    "consumer_dispute": [
      "Proof of delivery (tracking + signature)",
      "Signed contract or terms of service acceptance",
      "Merchant refund / cancellation policy shown at checkout",
      "Communication log with cardholder (email/chat)",
      "Photos or specs of the item as sold",
      "Recurring billing consent (opt-in record)"
    ]
  },
  "cross_network_notes": {
    "chargeback_timeframe_default": "Most dispute categories carry a 120-day filing window from transaction date or expected delivery date.",
    "fraud_shift_common": "Fraud codes generally shift liability to the party that did not support the higher security method (EMV chip, 3DS).",
    "amex_note": "Amex operates as both issuer and acquirer in a closed-loop; there is no 'representment' filed to a separate issuer, only 'Second Presentment' back to Amex.",
    "visa_vcr_note": "Visa's VCR platform auto-adjudicates many disputes at pre-arbitration if evidence thresholds are not met.",
    "mastercard_com_note": "Mastercom is the Mastercard dispute workflow platform; second presentment must include compelling evidence per the reason code."
  }
