---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllPosts, categoryOf, slugOf } from '../../../lib/posts';
import { getCategory } from '../../../lib/categories';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { category: categoryOf(post), slug: slugOf(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const cat = categoryOf(post);
const meta = getCategory(cat);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const year = post.data.year;
const authors = post.data.authors;
const doi = post.data.doi;
const tags = post.data.tags ?? [];
---

<BaseLayout title={post.data.title} description={post.data.summary} activeNav="blog">
  <div class="breadcrumb">
    <a href={`${base}/blog/`}>Blog</a>
    <span class="sep">/</span>
    <a href={`${base}/blog/${cat}/`}>{meta ? meta.en : cat}</a>
    <span class="sep">/</span>
    <span>{post.data.title}</span>
  </div>

  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        {authors && <span>{authors}</span>}
        {year && <span>{year}</span>}
        {meta && <a href={`${base}/blog/${cat}/`}>{meta.ko} · {meta.en}</a>}
        {doi && <span>DOI: {doi}</span>}
      </div>
      {tags.length > 0 && (
        <div class="tag-row">
          {tags.map((t) => <span class="tag">#{t}</span>)}
        </div>
      )}
    </header>
    <div class="post-content">
      <Content />
    </div>
  </article>
</BaseLayout>
